      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "pricehunt-postgres"},
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS failed_runs FROM scheduled_job_run WHERE status IN ('FAILED', 'PARTIAL') AND $__timeFilter(started_at)",
          "refId": "A"
        }
      ],
      "title": "Failed/partial runs",
