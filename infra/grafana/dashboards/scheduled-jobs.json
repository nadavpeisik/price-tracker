      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "options": {"showHeader": true},
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "pricehunt-postgres"},
          "format": "table",
          "rawSql": "SELECT r.started_at AS \"Started\", r.job_name AS \"Job\", i.label AS \"Item\", i.error_message AS \"Error\", i.duration_ms AS \"Duration (ms)\" FROM scheduled_job_run_item i JOIN scheduled_job_run r ON i.job_run_id = r.id WHERE i.status = 'FAILED' AND $__timeFilter(r.started_at) ORDER BY r.started_at DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Failed items (time-picker scoped)",
      "type": "table"
    },
    {
      "datasource": {"type": "postgres", "uid": "pricehunt-postgres"},
      "fieldConfig": {
        "defaults": {"unit": "ms", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80}},
