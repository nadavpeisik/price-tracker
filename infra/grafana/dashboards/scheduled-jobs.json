      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "pricehunt-postgres"},
          "format": "time_series",
          "rawSql": "SELECT started_at AS time, EXTRACT(EPOCH FROM (finished_at - started_at)) * 1000 AS value, job_name AS metric FROM scheduled_job_run WHERE finished_at IS NOT NULL AND $__timeFilter(started_at) ORDER BY started_at",
          "refId": "A"
        }
      ],
      "title": "Run duration by job",
      "type": "timeseries"
    }
