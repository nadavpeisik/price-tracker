# Values containing '$' must be single-quoted (VAR='Pa$sw0rd') — Docker Compose
# interpolates '$' in unquoted .env values and would silently truncate them.
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme

# Grafana web login (was hard-coded admin/admin before #242)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Password for grafana_reader, the SELECT-only Postgres role the Grafana
# datasource connects as (created by infra/postgres/init/create-grafana-role.sh)
GRAFANA_DB_PASSWORD=changeme

# Password for bff_session, the Postgres role that owns the bff_sessions schema the BFF's
# Spring Session store lives in (created by infra/postgres/init/create-bff-role.sh, #247).
# The BFF itself reads it from the environment: set -a; . ./.env; set +a
BFF_DB_PASSWORD=changeme

# Auth0 confidential client for the BFF (#247). AUTH0_ISSUER_URI is shared with the backend
# (trailing slash mandatory); the client id/secret come from the Regular Web Application.
# Not read by Docker Compose -- exported into the shell for ./mvnw spring-boot:run.
# AUTH0_ISSUER_URI=https://tenant.eu.auth0.com/
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
