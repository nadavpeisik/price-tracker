POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme

# Grafana web login (was hard-coded admin/admin before #242)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Password for grafana_reader, the SELECT-only Postgres role the Grafana
# datasource connects as (created by infra/postgres/init/create-grafana-role.sh)
GRAFANA_DB_PASSWORD=changeme
